HYDRA_DB_API_KEY=
HYDRA_DATABASE=throughline_demo
HYDRA_COLLECTION=northstar_knowledge
HYDRA_MEMORY_COLLECTION=approvals_memory
OPENAI_API_KEY=
# gpt-6-luna: cheapest GPT-6 model; covered by OpenAI's complimentary daily tokens
# when data sharing is enabled. Leave OPENAI_REASONING_EFFORT empty for non-reasoning
# models such as gpt-4.1-mini.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
DATA_DIR=./data
SQLITE_PATH=./data/throughline.db
NEXT_PUBLIC_API_URL=http://localhost:8000
# Cost guardrail: max analyses (the only OpenAI-calling route) per client IP per UTC day; 0 disables.
RATE_LIMIT_ANALYZE_PER_DAY=10
# Set to 1 only behind a proxy you control, so X-Forwarded-For can't be spoofed.
TRUST_PROXY_HEADERS=
